# Build trees and caches
build*/
.cache/
__pycache__/
*.pyc
.DS_Store

# LaTeX outputs
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
latex/main.pdf

# Keynote decks (large binaries)
notes/*.key

# Papers (PDFs of the references)
bib/

# Benchmark data and outputs: regenerated by the scripts (generate.py,
# makeSynthetic, render_all.py, run_*.py)
benchmarks/synthetic/results*/
benchmarks/synthetic/images/
benchmarks/bourne/results/

# Third-party code, environments and installs. geogram and the two Bourne et
# al. repositories are submodules; exploragram_ot is a copy that the build
# needs, so it is tracked. The rest of external/bourne is made by
# benchmarks/setup_bourne.sh.
external/bourne/.venv/
external/bourne/src/
external/bourne/runs/
external/cgal-6.0.1/
external/install/

# Compiled pp2d baseline (built by benchmarks/pp2d/pp2/build_pp2.sh)
benchmarks/pp2d/pp2/bin/

# Per-case trajectories of the overnight synthetic run (2.4 GB); the summaries are in log-synthetic.csv
benchmarks/overnight/*/synthetic/
