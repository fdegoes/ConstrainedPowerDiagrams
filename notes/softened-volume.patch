+DualSolver::Result
+SoftenedSolver::Solve(
+    const Domain& domain,
+    const std::vector<double>& sites,
+    const std::vector<double>& targets,
+    const std::vector<double>& volumes,
+    double alpha,
+    double beta,
+    const std::vector<double>& referenceWeights,
+    std::vector<double>& shifts,
+    std::vector<double>& weights)
+{
+    std::string err;
+    if (not _CheckDualInputs(domain, sites, targets, volumes, err)) {
+        return _MakeInputError(err);
+    }
+    if (not (alpha > 0.0) or not (beta > 0.0) or (not std::isfinite(alpha) and not std::isfinite(beta))) {
+        return _MakeInputError("The stiffnesses alpha and beta must be positive, and not both infinite.");
+    }
+    if (referenceWeights.size() != volumes.size() or not AreAllFinite(referenceWeights)) {
+        return _MakeInputError("The reference weights must be one finite value per site.");
+    }
+    JointDual dual(domain, sites, targets, volumes, alpha, JointDual::Unknowns::ShiftsAndWeights);
+    dual.SetVolumeSoftening(beta, referenceWeights);
+    Vector z = _PackInitial(dual, shifts, weights);
+    Result res = _Solve(dual, z);
+    dual.Unpack(z, shifts, weights);
+    return res;
+}
+
 DualSolver::Result
 CentroidSolver::Solve(
     const Domain& domain,
