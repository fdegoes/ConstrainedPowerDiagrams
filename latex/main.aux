\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces E1 (top), E2 (middle), E3 (bottom). Blue dots are the target barycentres $\mathbf  {b}_i$, red the achieved centroids $\mathbf  {c}_i$; where a cell is fitted the two coincide. All four panels of a row are drawn by the same renderer from the same instance, so any difference is in the tessellation, not in the drawing. E4 (top) and E5 (bottom). In E4 \textsc  {Block Ascend}'s tessellation is visibly wrong --- it stalls at $1.1\cdot 10^{-1}$ --- while \textsc  {Joint Newton} is indistinguishable from the truth. In E5 \emph  {no} method recovers the herringbone of the ground truth, and \textsc  {Joint Newton} and \textsc  {sg} converge to visibly the same incorrect tessellation from completely different directions.\relax }}{9}{figure.caption.30}\protected@file@percent }
\newlabel{fig:rows1}{{1}{9}{E1 (top), E2 (middle), E3 (bottom). Blue dots are the target barycentres $\mathbf {b}_i$, red the achieved centroids $\mathbf {c}_i$; where a cell is fitted the two coincide. All four panels of a row are drawn by the same renderer from the same instance, so any difference is in the tessellation, not in the drawing. E4 (top) and E5 (bottom). In E4 \textsc {Block Ascend}'s tessellation is visibly wrong --- it stalls at $1.1\cdot 10^{-1}$ --- while \textsc {Joint Newton} is indistinguishable from the truth. In E5 \emph {no} method recovers the herringbone of the ground truth, and \textsc {Joint Newton} and \textsc {sg} converge to visibly the same incorrect tessellation from completely different directions.\relax }{figure.caption.30}{}}
\bibcite{Bourne2026ConvexOrder}{{5}{2026}{{Bourne et~al\mbox  {.}}}{{}}}
\bibcite{Bourne2025Inverting}{{6}{2025}{{Bourne et~al\mbox  {.}}}{{}}}
\bibcite{deGoes2014Thesis}{{7}{2014}{{de~Goes}}{{}}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Figure N. Fitting the reducible $N=728$ cross of Bourne et al. Top: the whole domain; bottom: the bottom-left corner, $0.30\times 0.30$. Blue dots are the target barycentres $\mathbf  {b}_i$, red the achieved centroids. The ground-truth tessellation is a herringbone — two families of long thin cells meeting along a straight diagonal seam running from each corner to the centre. The subgradient scheme of Bourne et al. and the regularized solve under its shipped alternation both return a rounded radial fan that loses this structure entirely, differing from each other mainly in where the error is concentrated: the subgradient scheme meets the cell areas by construction, since every iterate is recovered through a transport solve, while the alternation surrenders $5.7\%$ of area error. Solving the same entropic problem with a joint Newton step over $(\mathbf  {s}, \mathbf  {z}, \mathbf  {u})$ instead of alternating between the grid and point blocks recovers the herringbone, and attains the lowest centroid error of any method we tested on this instance, $9.5\cdot 10^{-4}$. The regularization is $\varepsilon = 3\cdot 10^{-4}$ on a $256^2$ grid for both regularized columns; the joint solve reaches its result in $45$ iterations and $71$ seconds, against $176$ seconds and $4000$ iterations for the alternation, which never drives both marginals down together — forcing either one to $10^{-15}$ leaves the other near $10^{-2}$.\relax }}{10}{figure.caption.34}\protected@file@percent }
\newlabel{fig:ebsd}{{2}{10}{Figure N. Fitting the reducible $N=728$ cross of Bourne et al. Top: the whole domain; bottom: the bottom-left corner, $0.30\times 0.30$. Blue dots are the target barycentres $\mathbf {b}_i$, red the achieved centroids. The ground-truth tessellation is a herringbone — two families of long thin cells meeting along a straight diagonal seam running from each corner to the centre. The subgradient scheme of Bourne et al. and the regularized solve under its shipped alternation both return a rounded radial fan that loses this structure entirely, differing from each other mainly in where the error is concentrated: the subgradient scheme meets the cell areas by construction, since every iterate is recovered through a transport solve, while the alternation surrenders $5.7\%$ of area error. Solving the same entropic problem with a joint Newton step over $(\mathbf {s}, \mathbf {z}, \mathbf {u})$ instead of alternating between the grid and point blocks recovers the herringbone, and attains the lowest centroid error of any method we tested on this instance, $9.5\cdot 10^{-4}$. The regularization is $\varepsilon = 3\cdot 10^{-4}$ on a $256^2$ grid for both regularized columns; the joint solve reaches its result in $45$ iterations and $71$ seconds, against $176$ seconds and $4000$ iterations for the alternation, which never drives both marginals down together — forcing either one to $10^{-15}$ leaves the other near $10^{-2}$.\relax }{figure.caption.34}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The EBSD steel micrograph of Bourne et al.\ \citep  {Bourne2026}, $N=243$ grains, with the areas and barycentres of those grains as the targets. This is not a valid diagram, so ours doesn't converge. Might be a good idea to run the one with softened constraints.\relax }}{10}{figure.caption.35}\protected@file@percent }
\newlabel{fig:ebsd}{{3}{10}{The EBSD steel micrograph of Bourne et al.\ \cite {Bourne2026}, $N=243$ grains, with the areas and barycentres of those grains as the targets. This is not a valid diagram, so ours doesn't converge. Might be a good idea to run the one with softened constraints.\relax }{figure.caption.35}{}}
